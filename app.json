{
  "expo": {
    "name": "Sponge",
    "slug": "sponge",
    "scheme": "sponge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.denizirban.sponge",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Sponge hareket molalarını hatırlatmak için bildirim gönderir."
      }
    },
    "android": {
      "package": "com.denizirban.sponge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/mascot.png",
        "backgroundColor": "#F5F7EC"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "sponge-breaks"
        }
      ]
    ],
    "extra": {
      "eas": {}
    }
  }
}
